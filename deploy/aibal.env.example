# Secret settings of AIBAL on e-INFRA. Copy to aibal.env outside synced folders, fill in, then:
#   kubectl create secret generic aibal-secrets --from-env-file=<path>\aibal.env --dry-run=client -o yaml | kubectl apply -f -
# and restart the app (kubectl rollout restart deployment/aibal)
# Format: KEY=value, no quotes - the value is taken literally. Database settings are not needed here.

# long random string; reuse the one from the current server to keep e-mail links working across the move
SECRET_KEY=

# e-mail (the same values as on the current server)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=True
MAIL_USE_SSL=False
# JSON list of the addresses that confirm new companies and receive contact messages
ADMIN_EMAIL_ADDRESSES=["admin@example.com"]

# reCAPTCHA v3 keys of the site registered for aibal.dyn.cloud.e-infra.cz (logins with a score below 0.85 are refused)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
