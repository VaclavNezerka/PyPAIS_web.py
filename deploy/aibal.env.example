# Secret settings of AIBAL on e-INFRA. Copy to deploy/aibal.env (git-ignored), fill in, then:
#   kubectl create secret generic aibal-secrets --from-env-file=deploy/aibal.env
# (to change it later: add --dry-run=client -o yaml | kubectl apply -f -  and restart the app)
# Format: KEY=value, no quotes - the value is taken literally. Database settings are not needed here.

# long random string; reuse the one from the current server to keep e-mail links working across the move
SECRET_KEY=

# e-mail (the same values as on the current server)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=True
MAIL_USE_SSL=False
# JSON list of the addresses that confirm new companies and receive contact messages
ADMIN_EMAIL_ADDRESSES=["admin@example.com"]

# reCAPTCHA v2 keys; add aibal.dyn.cloud.e-infra.cz to the site's domains in the reCAPTCHA admin console
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
